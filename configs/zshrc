# Prompt
## Evaluate variables inside the prompt dynamically
setopt prompt_subst

## Enable native vcs_info support
autoload -Uz vcs_info
precmd() { vcs_info }

## Enable git backend and check for changes on every command
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:git*:*' get-revision true

## Configure git part of the prompt to match maran theme
zstyle ':vcs_info:git:*' formats ' %F{cyan}git:(%F{39}%b%F{cyan})%f'

## Match maran theme
PROMPT='%F{cyan}%n%f@%F{yellow}%m%f:%F{green}%~%f${vcs_info_msg_0_} $ '


# Key Bindings
## Enable standard keyboard mapping definitions
bindkey -e

## Map Ctrl+Left Arrow to move back one word
bindkey '^[[1;5D' backward-word

## Map Ctrl+Right Arrow to move forward one word
bindkey '^[[1;5C' forward-word

## Map Ctrl+Backspace (Linux/X11 default sequence) to delete a word backward
bindkey '^H' backward-kill-word

## Map Ctrl+Backspace (macOS/Ghostty alternative sequence) to delete a word backward
bindkey '^[[3;5~' backward-kill-word

## Map home/pos1 key to move to the beginning of the line
bindkey '^[[1~' beginning-of-line

## Map end key to move to the end of the line
bindkey '^[[4~' end-of-line

## Map delete key to delete the character under the cursor
bindkey '^[[3~' delete-char

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=200000
SAVEHIST=100000

## Don't save commands that start with a space to history
setopt HIST_IGNORE_SPACE

## Share history between all sessions
setopt SHARE_HISTORY


PATH="$PATH:$HOME/bin:$HOME/.local/bin:$HOME/git/arch-config/scripts"

# Aliases
alias abcde="abcde -c ~/git/arch-config/configs/abcde.conf"
alias adpdf="asciidoctor -r asciidoctor-pdf -b pdf -a pdf-style='theme.yml'"
alias docker="sudo docker"
alias docker-compose="sudo docker-compose"
alias pacman="sudo pacman"
alias mountdata="if ! grep -qs '/mnt/data-drive' /proc/mounts; then sudo cryptsetup luksOpen /dev/disk/by-uuid/6ed8cf7b-1fb2-4dad-9648-14adb275e8f7 data-drive && sudo mount /dev/mapper/data-drive /mnt/data-drive;fi"
alias ydl="~/git/tools/ydl/ydl.py"
alias tf="terraform"
alias "??"="copilot --allow-all-tools -p"

if [ -z "$TMUX" ]; then
    tmux new-session -A -s 0 '~/git/arch-config/scripts/tmux-session-startup.sh; exec zsh'
fi
