# Ghostty window
window-decoration = server
title = Terminal

# Font
#font-family = Monospace Regular
font-family = JetBrains Mono
font-style = Medium
font-size = 10

# Colours
palette = 0=#000000
palette = 1=#cc0000
palette = 2=#4e9a06
palette = 3=#c4a000
palette = 4=#3465a4
palette = 5=#75507b
palette = 6=#06989a
palette = 7=#d3d7cf
palette = 8=#555753
palette = 9=#ef2929
palette = 10=#8ae234
palette = 11=#fce94f
palette = 12=#739fcf
palette = 13=#ad7fa8
palette = 14=#34e2e2
palette = 15=#eeeeec
background = #0d0e1c
foreground = #d0d0cf
cursor-color = #e6e6e6

# might help with statusbar padding issue, currently only supported on macos
# window-step-resize = true

# Notifications
app-notifications = no-clipboard-copy
